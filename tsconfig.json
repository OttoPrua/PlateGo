{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "chrome", "vitest/globals"]
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "services/**", "private/**"]
}
