{
  "name": "@platego/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "build": "vite build",
    "test": "node --test scripts/*.test.mjs",
    "validate": "node scripts/validate-build.mjs",
    "fixture:api": "node scripts/fixture-api.mjs",
    "smoke:fixture": "node scripts/smoke-fixture.mjs",
    "check": "npm run test && npm run build && npm run validate"
  },
  "dependencies": {
    "@platego/client-app": "*",
    "@platego/core": "*",
    "@platego/sim-data": "*",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287"
  }
}
